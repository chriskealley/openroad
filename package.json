{
  "name": "openspec-roadmap",
  "version": "0.1.0",
  "description": "A roadmap companion for OpenSpec projects",
  "type": "module",
  "bin": { "openspec-roadmap": "dist/src/cli.js" },
  "files": ["dist/src", "templates", "skills", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["openspec", "roadmap", "codex", "cli"],
  "engines": { "node": ">=20" },
  "dependencies": { "yaml": "^2.8.1" },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
